# Modo demonstração SOMENTE para desenvolvimento local.
# Em produção este valor é ignorado mesmo que seja definido como true.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (obrigatório em produção)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Integração somente leitura com o projeto separado Basso Fiscal.
# Segredo exclusivo de servidor; nunca use NEXT_PUBLIC_ e nunca comite o valor real.
FISCAL_API_KEY=

# Push / campanhas
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
RESEND_API_KEY=
CAMPAIGN_FROM_EMAIL=

# iFood — credenciais e homologação devem ser concluídas antes de ativar a feature.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_WEBHOOK_SECRET=
IFOOD_BASE_URL=https://merchant-api.ifood.com.br

# 99Food — aplicativo PedidoPro 99Food Teste.
# APP ID, Secret, Shop ID e token devem existir SOMENTE no servidor/Vercel.
FOOD99_ENVIRONMENT=test
FOOD99_APP_ID=
FOOD99_APP_SECRET=
FOOD99_SHOP_ID=
FOOD99_SHOP_TOKEN=
FOOD99_APP_SHOP_ID=basso_teste_001
# FOOD99_API_BASE_URL só deve ser criado depois de confirmar o valor na documentação oficial.

# Laranjinha Smart / Rede
# Nenhuma credencial REST é definida aqui antes da liberação do SDK/App2App oficial e certificação Smart Store.

# Pix / gateway opcional
PIX_KEY=
PIX_KEY_TYPE=
PIX_PROVIDER=manual
PIX_PROVIDER_TOKEN=

# Segurança operacional / filas
TRACKING_TOKEN_TTL_MINUTES=180
CRON_SECRET=
MARKETPLACE_AUTO_ACCEPT=false

# Impressão local
PRINT_BRIDGE_KEY=

# Coordenadas da loja para mapa operacional (confirmar antes de produção)
NEXT_PUBLIC_STORE_LATITUDE=
NEXT_PUBLIC_STORE_LONGITUDE=

# Bootstrap temporário de usuários, se ainda necessário na instalação.
INITIAL_USER_PASSWORD=
